# Copy to .env.local and replace every placeholder. Do not commit .env.local.

# Clerk. @clerk/nextjs reads these when ClerkProvider is used without key props.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me
STRIPE_PRICE_ID_PRO_PLUS=price_replace_me
STRIPE_TOKEN_PRICE_ID=price_replace_me
STRIPE_TOKEN_GRANT=100

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Model providers. A workflow uses Groq, OpenAI, or both, depending on the route.
GROQ_API_KEY=replace_me
OPENAI_API_KEY=replace_me
MODEL_NAME=replace_me
OPENAI_REALTOR_REPLY_MODEL=replace_me
OPENAI_SHOWING_NOTES_MODEL=replace_me
OPENAI_OPEN_HOUSE_NOTES_MODEL=replace_me
OPENAI_LISTING_MODEL=replace_me
OPENAI_REALGPT_MODEL=replace_me

# Mailgun inbound email
MAILGUN_API_KEY=replace_me
MAILGUN_DOMAIN=example.mailgun.org
INBOUND_EMAIL=inbound@example.com
INBOUND_EMAIL_SECRET=replace_me
INBOUND_WEBHOOK_URL=https://example.com/api/showing-notes/inbound-email

# Optional. Set to 1 to log Groq usage outside Vercel.
GROQ_USAGE_LOG=0
